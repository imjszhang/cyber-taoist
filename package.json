{
  "name": "cyber-taoist",
  "private": true,
  "type": "module",
  "bin": {
    "cybertaoist": "./cli/cli.js"
  },
  "scripts": {
    "site:dev": "node scripts/sync-site-constitution.mjs && npx serve site/src",

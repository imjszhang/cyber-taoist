{
  "name": "cyber-taoist",
  "private": true,
  "type": "module",
  "bin": {
    "cybertaoist": "./tools/cli.js"
  },
  "scripts": {
    "content:sync": "node tools/sync-content.mjs",
    "site:dev": "node tools/build.js && npx serve dist",
    "site:build": "node tools/build.js",
    "site:preview": "npx serve dist -l 3000",
    "cli": "node tools/cli.js",
    "cf:setup": "node tools/setup-cloudflare.js",
    "gh:pages": "node tools/setup-github-pages.js",
    "deploy:setup": "npm run cf:setup && npm run gh:pages",
    "site:check": "node --test tools/site.test.js && node tools/check-site.js",
    "site:validate": "npm run site:build && npm run site:check"
  },
  "devDependencies": {
    "marked": "18.1.0",
    "sharp": "0.35.5"
  },
  "version": "2.2.0",
  "engines": {
    "node": ">=22"
  }
}
